---
import Shell from '../../layouts/Shell.astro';
import Icon from '../../components/Icon.astro';
import { book, chapterHref, href, renderContent, groupFor } from '../../lib/book';
export function getStaticPaths(){return book.chapters.map(chapter=>({params:{slug:chapter.slug},props:{chapter}}));}
const {chapter}=Astro.props;
const previous=book.chapters[chapter.number-2],next=book.chapters[chapter.number];
const refs=book.references.filter(ref=>chapter.references.some(r=>r.key===ref.key));
const minutes=Math.max(1,Math.ceil(chapter.searchText.split(/\s+/).length/220));
const firstFigure=chapter.figures[0];
---
<Shell title={chapter.title} active="book" reader>
  <div class="reading-progress" aria-hidden="true"></div>
  <main class="reader-frame" id="main">
    <article class="reader-main" id="top">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href={href('book/')}>The book</a><span>/</span><span>{groupFor(chapter.number).name}</span></nav>
      <header class="chapter-heading"><span class="eyebrow">CHAPTER {String(chapter.number).padStart(2,'0')}</span><h1>{chapter.title}</h1><div class="chapter-meta"><span>{minutes} MIN READ</span><span>{chapter.sections.filter(s=>s.level===1).length} SECTIONS</span><a href="#chapter-references">{chapter.references.length} SOURCES</a><span>29 OCT 2026</span></div></header>
      <div class="reader-controls"><details class="local-outline"><summary><Icon name="menu" size={17} /> In this chapter <span>{chapter.sections.filter(s=>s.level===1).length} sections</span></summary><nav data-section-nav aria-label="Sections in this chapter">{chapter.sections.filter(s=>s.level===1).map(s=><a href={`#${s.anchor}`}><span>{s.number}</span>{s.title}</a>)}</nav></details><div class="reading-size" role="group" aria-label="Reading text size"><button data-text-size="small" aria-label="Compact reading text" aria-pressed="false">S</button><button data-text-size="medium" aria-label="Standard reading text" aria-pressed="true">M</button><button data-text-size="large" aria-label="Large reading text" aria-pressed="false">L</button></div></div>
      <div class="prose" set:html={renderContent(chapter.html)}></div>
      <details class="chapter-sources" id="chapter-references"><summary>References cited in this chapter <span class="muted">({refs.length})</span></summary><ol>{refs.map(ref=><li value={ref.number}><div set:html={renderContent(ref.html)}></div><a href={href('references/')+`#${ref.id}`}>Reference {ref.number}</a></li>)}</ol></details>
      <nav class="chapter-pagination" aria-label="Adjacent chapters">{previous?<a href={chapterHref(previous.slug)}><small>PREVIOUS · CHAPTER {previous.number}</small>{previous.title}</a>:<a href={href('book/')}><small>THE COMPLETE MONOGRAPH</small>Explore all chapters</a>}{next?<a href={chapterHref(next.slug)}><small>NEXT · CHAPTER {next.number}</small>{next.title}</a>:<a href={href('about/')}><small>EDITION AND EVIDENCE</small>About this monograph</a>}</nav>
    </article>
    <aside class="chapter-margin" aria-label="Chapter companion"><div class="margin-edition"><span>THE ONLINE MONOGRAPH</span><strong>{String(chapter.number).padStart(2,'0')} <span>/ 34</span></strong></div>{firstFigure&&<a class="margin-figure" href={`#${firstFigure.id}`}><img src={firstFigure.src.replace('__BOOK_BASE__',import.meta.env.BASE_URL.replace(/\/?$/,'/'))} alt={`Figure ${firstFigure.number}; open the complete figure and caption in this chapter.`} width="1536" height="1024" loading="lazy" /><span>Figure {firstFigure.number} <Icon name="arrow" size={14} /></span></a>}<div class="margin-position"><span class="eyebrow">YOU ARE READING</span><p data-current-section>{chapter.sections.find(s=>s.level===1)?.number} {chapter.sections.find(s=>s.level===1)?.title}</p></div><div class="reader-tools"><button data-open-contents><Icon name="book" size={16} /> All chapters</button><a href={href('downloads/agentic-state.pdf')}><Icon name="download" size={16} /> Complete PDF</a></div></aside>
  </main>
</Shell>
