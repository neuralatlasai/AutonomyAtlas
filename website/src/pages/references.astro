---
import Shell from '../layouts/Shell.astro';
import { book, chapterHref, renderContent } from '../lib/book';
---
<Shell title="References" active="references"><main id="main" class="site-width"><header class="page-intro" id="top"><span class="eyebrow">THE EVIDENCE BEHIND THE ARGUMENT</span><h1>References.</h1><p>356 cited scholarly and technical sources, linked to the chapters that use them. Numbering follows the complete PDF edition.</p></header><div class="catalog-controls"><label><span class="sr-only">Filter references</span><input class="filter-input" type="search" placeholder="Search title, author, or source…" data-filter-references /></label><span class="eyebrow" role="status" aria-live="polite" data-reference-count>356 REFERENCES</span></div><ol class="reference-list">{book.references.map(ref=><li id={ref.id} data-ref-search={ref.text.toLowerCase()}><span class="ref-number">{ref.number}</span><div><div set:html={renderContent(ref.html)}></div><div class="ref-chapters">{ref.chapterIds.map(id=>{const c=book.chapters.find(ch=>ch.id===id)!;return <a href={chapterHref(c.slug)}>Chapter {c.number}</a>;})}</div></div></li>)}</ol><p hidden class="catalog-empty" data-reference-empty>No sources match these terms.</p></main><script>
 const input=document.querySelector<HTMLInputElement>('[data-filter-references]');input?.addEventListener('input',()=>{const terms=input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);let n=0;document.querySelectorAll<HTMLElement>('[data-ref-search]').forEach(row=>{row.hidden=!terms.every(term=>row.dataset.refSearch?.includes(term));if(!row.hidden)n++;});const count=document.querySelector('[data-reference-count]');if(count)count.textContent=`${n} REFERENCES`;const empty=document.querySelector<HTMLElement>('[data-reference-empty]');if(empty)empty.hidden=n>0;});
 </script></Shell>
