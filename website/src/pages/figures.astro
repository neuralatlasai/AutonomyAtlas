---
import Shell from '../layouts/Shell.astro';
import { book, renderContent, chapterHref } from '../lib/book';
---
<Shell title="Figures" active="figures"><main id="main" class="site-width"><header class="page-intro" id="top"><span class="eyebrow">A VISUAL INDEX OF THE MONOGRAPH</span><h1>Mechanisms, made visible.</h1><p>35 original explanatory illustrations. Each figure belongs to a specific argument; none depicts generated experimental measurements.</p></header><div class="figure-grid">{book.chapters.flatMap(ch=>ch.figures.map(fig=><article class="figure-entry" id={`figure-${fig.number.replace('.','-')}`}><span class="eyebrow">CHAPTER {ch.number} · FIGURE {fig.number}</span><a href={fig.src.replace('__BOOK_BASE__',import.meta.env.BASE_URL.replace(/\/?$/,'/'))} target="_blank" aria-label={`Open full-resolution Figure ${fig.number}`}><img src={fig.src.replace('__BOOK_BASE__',import.meta.env.BASE_URL.replace(/\/?$/,'/'))} alt={fig.alt} width="1536" height="1024" loading="lazy" /></a><h2><a href={chapterHref(ch.slug)+`#${fig.id}`}>{ch.title}</a></h2><div class="figure-caption" set:html={renderContent(fig.captionHtml)}></div><a class="text-link" href={chapterHref(ch.slug)+`#${fig.id}`}>Read in context</a></article>))}</div></main></Shell>
