---
import search from '@phosphor-icons/core/assets/regular/magnifying-glass.svg?url';
import arrow from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?url';
import right from '@phosphor-icons/core/assets/regular/arrow-right.svg?url';
import left from '@phosphor-icons/core/assets/regular/arrow-left.svg?url';
import book from '@phosphor-icons/core/assets/regular/book-open.svg?url';
import menu from '@phosphor-icons/core/assets/regular/list.svg?url';
import close from '@phosphor-icons/core/assets/regular/x.svg?url';
import download from '@phosphor-icons/core/assets/regular/download-simple.svg?url';
import moon from '@phosphor-icons/core/assets/regular/moon.svg?url';
import stack from '@phosphor-icons/core/assets/regular/stack.svg?url';
import cpu from '@phosphor-icons/core/assets/regular/cpu.svg?url';
import shield from '@phosphor-icons/core/assets/regular/shield-check.svg?url';
import sparkle from '@phosphor-icons/core/assets/regular/sparkle.svg?url';
import arrows from '@phosphor-icons/core/assets/regular/arrows-clockwise.svg?url';
const icons: Record<string,string> = { search, arrow, right, left, book, menu, close, download, moon, stack, cpu, shield, sparkle, arrows };
interface Props { name: string; size?: number; }
const { name, size = 20 } = Astro.props;
---
<span class="icon" style={`--icon:url("${icons[name] ?? icons.book}");width:${size}px;height:${size}px`} aria-hidden="true"></span>
